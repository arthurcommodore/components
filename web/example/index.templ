package example

import (
	"github.com/arthurcommodore/components/language"
	assets_template "github.com/arthurcommodore/components/web/template/assets"
	translator_template "github.com/arthurcommodore/components/web/template/translator"
)

templ Page(language language.Language) {

	<!DOCTYPE html>
	<html lang="pt-BR">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Meu Projeto Base</title>
			@assets_template.Style("web/example/style.css")
		</head>
		<body>
			<header class="header">
				<h1>{language.Translator("title")}</h1>
				@translator_template.TranslatorButton(language)
			</header>
		</body>
	</html>
}
